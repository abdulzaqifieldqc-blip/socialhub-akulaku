# Variabel NON-RAHASIA ada di wrangler.jsonc (vars). Salin file ini hanya untuk pengembangan lokal (.dev.vars).
# RAHASIA di bawah ini diisi lewat Cloudflare Dashboard > Workers > socialhub-akulaku > Settings > Variables and Secrets (tipe Secret).
# JANGAN pernah commit nilai asli.
SUPABASE_SECRET_KEY=            # kunci rahasia backend dari Supabase (Project Settings > API keys)
TOKEN_ENC_KEY=                  # 32 byte acak, base64 (enkripsi token OAuth)
STATE_SECRET=                   # string acak panjang (tanda tangan state OAuth)
MEDIA_SIGNING_SECRET=           # string acak panjang (tautan media bertanda tangan)
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_SECRET=
THREADS_CLIENT_SECRET=
