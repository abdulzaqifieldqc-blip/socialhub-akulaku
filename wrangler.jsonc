{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialhub-akulaku",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "SUPABASE_URL": "https://fzmctdvkljhvpxxezwtk.supabase.co",
    "MEDIA_RETENTION_HOURS": "24",
    "MAX_UPLOAD_BYTES": "104857600",
    "MAX_PUBLISH_ATTEMPTS": "5",
    "META_GRAPH_VERSION": "v21.0",
    "PUBLIC_ORIGIN": "https://socialhub-akulaku.abdulzaqi-fieldqc.workers.dev",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_g2h_qh7G7ldmrZbq53ILFQ_uuJ6Somj"
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "socialhub-media" }],
  "queues": {
    "producers": [{ "binding": "PUBLISH_QUEUE", "queue": "socialhub-publish" }],
    "consumers": [
      { "queue": "socialhub-publish", "max_batch_size": 5, "max_retries": 5, "dead_letter_queue": "socialhub-publish-dlq" },
      { "queue": "socialhub-publish-dlq", "max_batch_size": 10 }
    ]
  },
  "triggers": { "crons": ["* * * * *", "*/15 * * * *"] }
}
